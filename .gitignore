# pixi environments
.pixi/

# Local planning files and scratch artifacts (never publish)
CLAUDE_CODE_*.txt
/*.mbst

# Mojo build artifacts
*.mojopkg
build/

# Platform-specific Python extension builds
*.so
*.dylib
*.dll

# Test serialization scratch files
.test_*.tmp
.test_*.tmp.*.mbx

# Built binaries (capi/build.sh, cli/build.sh, capi/run_c_tests.sh)
capi/test_capi
cli/mojotrees
capi_test_*.mbst

# macOS
.DS_Store

# Python
__pycache__/

# Wheel build artifacts (packaging/build_wheel.sh)
python/dist/
python/mojotrees.egg-info/
python/LICENSE

# Instruments captures (bench/apple/metal_capture.sh). A .trace bundle is
# about 120 MB per four seconds of traced run, and the reader caches its
# exported XML tables in a sibling directory that is larger still. The reduced
# text output is what belongs in bench/results/.
bench/apple/metal_traces/
*.trace/
*.trace.export/

# Agent worktrees: real git worktrees, never repo content.
.claude/worktrees/

# `mojo precompile` drops this beside the manifest. It is a build artifact
# of a compile, not content, and it reappears every time anyone verifies the
# package builds.
mojotrees.mojoc
