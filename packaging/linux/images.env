# Container images for Linux wheel builds and clean-install verification.
#
# NOT USED BY ANYTHING YET. No image here has been pulled, run, or inspected,
# and no digest below has been looked up.
#
# Every digest field is empty on purpose. A tag is a moving target: the image
# that builds a wheel today and the image that "reproduces" it next month can
# differ, and a release that cannot say which bytes it ran inside is not
# reproducible in any useful sense. Fill these in from
#
#     docker buildx imagetools inspect <ref>            # or
#     podman manifest inspect <ref>
#
# and commit the digest with the release. packaging/linux/build_wheel_linux.sh
# and .github/workflows/release-linux.yml both refuse container mode while the
# digest for the image they were asked to use is empty.
#
# Format: shell-sourceable, one VAR=value per line, no expansion.

# ---------------------------------------------------------------------------
# Build images (option B in packaging/linux/README.md)
#
# manylinux_2_28 is AlmaLinux 8, glibc 2.28. It is the correct build host *if*
# the pinned Mojo toolchain runs there, which is UNKNOWN and untested. Find that
# out before wiring these in; the workflow's default is native runners.
# ---------------------------------------------------------------------------
MANYLINUX_2_28_X86_64_REF=quay.io/pypa/manylinux_2_28_x86_64
MANYLINUX_2_28_X86_64_DIGEST=

MANYLINUX_2_28_AARCH64_REF=quay.io/pypa/manylinux_2_28_aarch64
MANYLINUX_2_28_AARCH64_DIGEST=

# ---------------------------------------------------------------------------
# Verification images
#
# Where a finished wheel gets clean-installed. These deliberately are NOT the
# build image: installing a wheel in the container that built it proves the
# wheel works next to its own toolchain, which is the failure mode the whole
# exercise exists to catch.
#
# The pair below is the useful spread: the oldest glibc the tag could claim, and
# an ordinary current distribution a user would actually have. A wheel has to
# pass on both before a manylinux tag is honest.
# ---------------------------------------------------------------------------
VERIFY_OLD_X86_64_REF=quay.io/pypa/manylinux_2_28_x86_64
VERIFY_OLD_X86_64_DIGEST=

VERIFY_OLD_AARCH64_REF=quay.io/pypa/manylinux_2_28_aarch64
VERIFY_OLD_AARCH64_DIGEST=

VERIFY_CURRENT_X86_64_REF=docker.io/library/ubuntu:24.04
VERIFY_CURRENT_X86_64_DIGEST=

VERIFY_CURRENT_AARCH64_REF=docker.io/library/ubuntu:24.04
VERIFY_CURRENT_AARCH64_DIGEST=

# ---------------------------------------------------------------------------
# Interpreter inside the verification container
#
# clean_install_linux.sh needs a CPython 3.14 on PATH and takes it from the
# PYTHON environment variable. In a manylinux image that is a path under
# /opt/python; in a plain Ubuntu image it has to be installed first, which the
# handoff spells out. Whether cp314 is present in these images has NOT been
# checked.
# ---------------------------------------------------------------------------
MANYLINUX_PYTHON=/opt/python/cp314-cp314/bin/python3.14
