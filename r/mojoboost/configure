#!/bin/sh
# Locate the mojoboost C ABI and generate src/Makevars.
#
# The package normally sits inside a mojoboost checkout at r/mojoboost, so the
# default is to walk up from here looking for capi/mojoboost.h. That also
# covers R CMD check, which unpacks the tarball into r/mojoboost.Rcheck/. Set
# MOJOBOOST_HOME to point at a checkout somewhere else entirely.
#
# Either way the library must already be built:
#
#     capi/build.sh
#
# The library is loaded by rpath rather than copied, so rebuilding the C ABI
# takes effect without reinstalling the package.
set -e

start=$(cd "$(dirname "$0")" && pwd)

find_home() {
    candidate=$1
    level=0
    while [ "$level" -lt 8 ]; do
        if [ -f "$candidate/capi/mojoboost.h" ]; then
            echo "$candidate"
            return 0
        fi
        parent=$(dirname "$candidate")
        if [ "$parent" = "$candidate" ]; then
            return 1
        fi
        candidate=$parent
        level=$((level + 1))
    done
    return 1
}

if [ -z "$MOJOBOOST_HOME" ]; then
    MOJOBOOST_HOME=$(find_home "$start") || {
        echo "configure: no capi/mojoboost.h above $start" >&2
        echo "configure: set MOJOBOOST_HOME to your mojoboost checkout" >&2
        exit 1
    }
elif [ ! -f "$MOJOBOOST_HOME/capi/mojoboost.h" ]; then
    echo "configure: MOJOBOOST_HOME=$MOJOBOOST_HOME has no capi/mojoboost.h" >&2
    exit 1
fi

found=""
for candidate in \
    "$MOJOBOOST_HOME/capi/libmojoboost.dylib" \
    "$MOJOBOOST_HOME/capi/libmojoboost.so"; do
    if [ -f "$candidate" ]; then
        found=$candidate
        break
    fi
done
if [ -z "$found" ]; then
    echo "configure: no libmojoboost in $MOJOBOOST_HOME/capi" >&2
    echo "configure: build it first with $MOJOBOOST_HOME/capi/build.sh" >&2
    exit 1
fi

# The package calls mojoboost_feature_importance and
# mojoboost_parameter_keys, which arrived in ABI version 3. Checking the
# header here turns an old checkout into a message at configure time rather
# than an undefined symbol at link time.
required=3
declared=$(sed -n 's/^#define MOJOBOOST_ABI_VERSION \([0-9]*\).*/\1/p' \
    "$MOJOBOOST_HOME/capi/mojoboost.h")
if [ -z "$declared" ]; then
    echo "configure: cannot read MOJOBOOST_ABI_VERSION from the header" >&2
    exit 1
fi
if [ "$declared" -lt "$required" ]; then
    echo "configure: this package needs mojoboost ABI >= $required, but" >&2
    echo "configure: $MOJOBOOST_HOME/capi/mojoboost.h declares $declared" >&2
    exit 1
fi

sed "s|@MOJOBOOST_HOME@|$MOJOBOOST_HOME|g" src/Makevars.in > src/Makevars
echo "configure: linking against $found (ABI $declared)"
