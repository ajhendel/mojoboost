"""The `mojoboost` command line tool: train and predict from text files.

Built by `cli/build.sh` into `cli/mojoboost`. It is a thin layer over the
Mojo API, so anything it can do is reachable from `mojoboost.model` and
`mojoboost.serialize` directly; the point is to make a model trainable and
usable without writing any code.

    mojoboost train --data train.csv --model model.mbst \
        --params "objective=binary num_iterations=200"
    mojoboost predict --model model.mbst --data test.csv --output pred.csv
    mojoboost info --model model.mbst

Hyperparameters come from the same parameter string the C ABI takes (see
params.mojo), so the two front ends never drift apart.

The data format is documented in cli/README.md and implemented by
`read_table` below. In short: one example per line, comma separated
numbers, optional header, `#` comments, and an empty field or `nan`/`na`/`?`
for a missing value.

Everything here except `main` is ordinary Mojo, so tests exercise the
parsing, the file reader, and the commands themselves rather than shelling
out to the binary.
"""

from std.sys import argv, exit, stderr

from mojoboost.boosting import IterationRange
from mojoboost.device import CPU_DEVICE, device_name, parse_device
from mojoboost.inspection import dump_model, dump_multiclass_model
from mojoboost.model import Model, MulticlassModel, fit, fit_multiclass
from mojoboost.params import objective_display_name, parse_params
from mojoboost.serialize import (
    load_model,
    load_multiclass_model,
    model_file_kind,
    save_model,
    save_multiclass_model,
)

comptime USAGE = String(
    """usage: mojoboost <command> [options]

commands:
  train    fit a model and write it to a file
  predict  score a data file with a saved model
  info     print what a saved model contains
  version  print the mojoboost version
  help     print this message

train options:
  --data FILE       training data, required
  --model FILE      where to write the fitted model, required
  --params STRING   "key=value key=value", LightGBM parameter names
  --label INDEX     label column, default 0, negative counts from the end
  --weight INDEX    per-row weight column, default none
  --header          skip the first line of the data file

predict options:
  --model FILE      saved model, required
  --data FILE       data to score, required
  --output FILE     where to write predictions, default stdout
  --label INDEX     label column to ignore, default none
  --raw             raw scores instead of response-scale predictions
  --start-iteration N  first boosting iteration to score with, default 0
  --num-iteration N    how many iterations from there, default all
  --device NAME     cpu, gpu, or auto; default cpu
  --header          skip the first line of the data file

info options:
  --model FILE      saved model, required
  --json            the full model as inspection-schema JSON

Data files hold one example per line as comma separated numbers. Blank
lines and lines starting with '#' are ignored, an empty field or nan, na,
or ? is a missing value, and every line must have the same number of
fields. See cli/README.md.

Training runs where the parameter string says: --params "device=gpu". There
is no --device for train, so there is only ever one place to look."""
)

# Keep in sync with capi/mojoboost_capi.mojo and python/pyproject.toml.
comptime VERSION = String("0.1.0")


struct Options(Copyable, Movable):
    """Parsed command line for one command.

    `label` and `weight` are raw column indices as typed, so a negative one
    counts from the last column the way Python indexing does. Whether the
    user gave them at all is a separate flag, because -1 is a meaningful
    index here and cannot double as "absent".
    """

    var data: String
    var model: String
    var output: String
    var params: String
    var label: Int
    var label_given: Bool
    var weight: Int
    var weight_given: Bool
    var header: Bool
    var raw: Bool
    var json: Bool
    var start_iteration: Int
    var num_iteration: Int
    var device: Int

    def __init__(out self):
        self.data = String("")
        self.model = String("")
        self.output = String("")
        self.params = String("")
        self.label = 0
        self.label_given = False
        self.weight = 0
        self.weight_given = False
        self.header = False
        self.raw = False
        self.json = False
        self.start_iteration = 0
        # LightGBM's convention, which `IterationRange.clamp` implements:
        # nonpositive means every iteration from the start on, so the
        # default scores the whole ensemble.
        self.num_iteration = 0
        self.device = CPU_DEVICE

    def iterations(self, n_iterations: Int) -> IterationRange:
        """The boosting iterations to predict with, clamped to what the
        loaded ensemble actually holds."""
        return IterationRange.clamp(
            n_iterations, self.start_iteration, self.num_iteration
        )


struct Table(Copyable, Movable):
    """A parsed data file: `n_rows` examples of `n_cols` fields each, held
    row-major in `values` so `values[r * n_cols + c]` is one field."""

    var values: List[Float64]
    var n_rows: Int
    var n_cols: Int

    def __init__(out self, var values: List[Float64], n_rows: Int, n_cols: Int):
        self.values = values^
        self.n_rows = n_rows
        self.n_cols = n_cols

    def at(self, row: Int, col: Int) -> Float64:
        return self.values[row * self.n_cols + col]


def parse_field(text: String) raises -> Float64:
    """One field of a data file. An empty field, or one of LightGBM's
    missing markers, becomes NaN, which the trainer treats as missing."""
    var s = String(text.strip())
    if (
        s.byte_length() == 0
        or s == "?"
        or s == "na"
        or s == "NA"
        or s == "n/a"
        or s == "N/A"
        or s == "nan"
        or s == "NaN"
        or s == "NAN"
        or s == "null"
        or s == "NULL"
    ):
        return Float64(String("nan"))
    # Mojo's float parser drops a second decimal point rather than
    # rejecting it, so "1.2.3" would silently become 1.23. A data file is
    # exactly where that kind of typo hides, so catch it here.
    var dots = 0
    for b in s.as_bytes():
        if b == 46:
            dots += 1
    if dots > 1:
        raise Error("'", s, "' is not a number")
    try:
        return Float64(s)
    except:
        raise Error("'", s, "' is not a number")


def read_table(path: String, has_header: Bool = False) raises -> Table:
    """Read a comma separated data file. Every retained line must have the
    same field count; the first retained line fixes it."""
    var content: String
    try:
        content = open(path, "r").read()
    except e:
        raise Error("cannot read '", path, "': ", e)

    var values = List[Float64]()
    var n_cols = 0
    var n_rows = 0
    var line_no = 0
    var skipped_header = not has_header

    for raw_line in content.split("\n"):
        line_no += 1
        var line = String(String(raw_line).strip())
        if line.byte_length() == 0:
            continue
        if line[byte=0] == "#":
            continue
        if not skipped_header:
            skipped_header = True
            continue

        var fields = line.split(",")
        if n_rows == 0:
            n_cols = len(fields)
            if n_cols == 0:
                raise Error(path, ":", line_no, ": no fields")
        elif len(fields) != n_cols:
            raise Error(
                path,
                ":",
                line_no,
                ": expected ",
                n_cols,
                " fields, found ",
                len(fields),
            )
        for field in fields:
            try:
                values.append(parse_field(String(field)))
            except e:
                raise Error(path, ":", line_no, ": ", e)
        n_rows += 1

    if n_rows == 0:
        raise Error("'", path, "' has no data rows")
    return Table(values^, n_rows, n_cols)


def resolve_column(index: Int, n_cols: Int, what: String) raises -> Int:
    """Resolve a column index, allowing Python style negatives so
    `--label -1` names the last column."""
    var resolved = index
    if resolved < 0:
        resolved += n_cols
    if resolved < 0 or resolved >= n_cols:
        raise Error(
            what, " column ", index, " is out of range for ", n_cols,
            " columns",
        )
    return resolved


def column_major_features(
    table: Table, label: Int, weight: Int
) raises -> List[Float64]:
    """The feature matrix in the column-major layout `fit` expects, with
    the label and weight columns left out."""
    var n_features = table.n_cols
    if label >= 0:
        n_features -= 1
    if weight >= 0:
        n_features -= 1
    if n_features < 1:
        raise Error("no feature columns are left after label and weight")

    var features = List[Float64](capacity=table.n_rows * n_features)
    for c in range(table.n_cols):
        if c == label or c == weight:
            continue
        for r in range(table.n_rows):
            features.append(table.at(r, c))
    return features^


def format_f64(x: Float64) -> String:
    return String(x)


def _next_value(
    args: List[String], mut i: Int, flag: String
) raises -> String:
    if i + 1 >= len(args):
        raise Error("option ", flag, " needs a value")
    i += 1
    return args[i].copy()


def _next_int(args: List[String], mut i: Int, flag: String) raises -> Int:
    var text = _next_value(args, i, flag)
    try:
        return Int(text)
    except:
        raise Error("option ", flag, " needs an integer, got '", text, "'")


def parse_options(args: List[String]) raises -> Options:
    """Parse the options of one command. `args` excludes the command name."""
    var options = Options()
    var i = 0
    while i < len(args):
        var flag = args[i].copy()
        if flag == "--data":
            options.data = _next_value(args, i, flag)
        elif flag == "--model":
            options.model = _next_value(args, i, flag)
        elif flag == "--output" or flag == "--out":
            options.output = _next_value(args, i, flag)
        elif flag == "--params":
            options.params = _next_value(args, i, flag)
        elif flag == "--label":
            options.label = _next_int(args, i, flag)
            options.label_given = True
        elif flag == "--weight":
            options.weight = _next_int(args, i, flag)
            options.weight_given = True
        elif flag == "--start-iteration" or flag == "--start_iteration":
            options.start_iteration = _next_int(args, i, flag)
        elif flag == "--num-iteration" or flag == "--num_iteration":
            options.num_iteration = _next_int(args, i, flag)
        elif flag == "--device":
            # `parse_device` is the one place a device name is spelled, so
            # the CLI accepts exactly what the parameter string and the
            # Python API accept, and rejects the rest with the same message.
            options.device = parse_device(_next_value(args, i, flag))
        elif flag == "--header":
            options.header = True
        elif flag == "--raw":
            options.raw = True
        elif flag == "--json":
            options.json = True
        else:
            raise Error("unknown option '", flag, "'")
        i += 1
    return options^


def command_train(args: List[String]) raises -> String:
    """Fit a model and save it. Returns the line to print on success."""
    var options = parse_options(args)
    if options.data.byte_length() == 0:
        raise Error("train needs --data")
    if options.model.byte_length() == 0:
        raise Error("train needs --model")

    var config = parse_params(options.params)
    var table = read_table(options.data, options.header)
    # Column 0 is the label unless told otherwise, which is where LightGBM's
    # own text format puts it.
    var label = resolve_column(options.label, table.n_cols, String("label"))
    var weight = -1
    if options.weight_given:
        weight = resolve_column(
            options.weight, table.n_cols, String("weight")
        )
        if weight == label:
            raise Error("the label and weight columns must differ")

    var features = column_major_features(table, label, weight)
    var n_features = len(features) // table.n_rows

    var sample_weight = List[Float64]()
    if weight >= 0:
        sample_weight = List[Float64](capacity=table.n_rows)
        for r in range(table.n_rows):
            sample_weight.append(table.at(r, weight))

    var summary: String
    if config.is_multiclass():
        var labels = List[Int](capacity=table.n_rows)
        for r in range(table.n_rows):
            var v = table.at(r, label)
            var k = Int(v)
            if Float64(k) != v or k < 0 or k >= config.n_classes:
                raise Error(
                    "multiclass labels must be integers in 0..num_class-1;"
                    " row ",
                    r + 1,
                    " is ",
                    v,
                )
            labels.append(k)
        var model = fit_multiclass(
            features,
            table.n_rows,
            n_features,
            labels,
            config.n_classes,
            config.booster,
            config.max_bin,
            sample_weight,
            device=config.device,
            use_missing=config.use_missing,
        )
        save_multiclass_model(model, options.model)
        summary = String(
            "trained multiclass model: ",
            len(model.booster.trees),
            " trees, ",
            config.n_classes,
            " classes, ",
            n_features,
            " features, ",
            table.n_rows,
            " rows, device ",
            device_name(config.device),
            " -> ",
            options.model,
        )
    else:
        var target = List[Float64](capacity=table.n_rows)
        for r in range(table.n_rows):
            target.append(table.at(r, label))
        var model = fit(
            features,
            table.n_rows,
            n_features,
            target,
            config.objective,
            config.booster,
            config.max_bin,
            sample_weight,
            config.alpha,
            device=config.device,
            use_missing=config.use_missing,
        )
        save_model(model, options.model)
        summary = String(
            "trained ",
            objective_display_name(config.objective),
            " model: ",
            len(model.booster.trees),
            " trees, ",
            n_features,
            " features, ",
            table.n_rows,
            " rows, device ",
            device_name(config.device),
            " -> ",
            options.model,
        )
    return summary^


def _check_width(expected: Int, found: Int) raises:
    if expected != found:
        raise Error(
            "the model expects ",
            expected,
            " features but the data has ",
            found,
        )


def _format_matrix(values: List[Float64], n_rows: Int, width: Int) -> String:
    """A row-major `[r * width + k]` result as one line per row, values
    comma separated."""
    var out = String("")
    for r in range(n_rows):
        for k in range(width):
            if k > 0:
                out += ","
            out += format_f64(values[r * width + k])
        out += "\n"
    return out^


def predictions_text(
    model_path: String, table: Table, label: Int, options: Options
) raises -> String:
    """Score every row of `table` and format the result, one line per row
    and one comma separated value per output.

    The scoring itself is `Model.predict_batch` (model.mojo), the same call
    the C ABI and the Python package make. So the iteration range and the
    device this reads off `options` are not a CLI feature: they are the
    model's own prediction surface, spelled as flags.
    """
    var features = column_major_features(table, label, -1)
    var n_features = len(features) // table.n_rows

    if model_file_kind(model_path) == "multiclass":
        var model = load_multiclass_model(model_path)
        _check_width(model.mapper.n_features, n_features)
        var rng = options.iterations(model.booster.n_iterations())
        var values = model.predict_batch(
            features, table.n_rows, rng, options.raw, options.device
        )
        return _format_matrix(
            values, table.n_rows, model.booster.n_classes
        )

    var model = load_model(model_path)
    _check_width(model.mapper.n_features, n_features)
    var rng = options.iterations(model.booster.n_iterations())
    var values = model.predict_batch(
        features, table.n_rows, rng, options.raw, options.device
    )
    return _format_matrix(values, table.n_rows, 1)


def command_predict(args: List[String]) raises -> String:
    """Score a data file. Returns the text to write, which `run` sends to
    --output or to stdout."""
    var options = parse_options(args)
    if options.model.byte_length() == 0:
        raise Error("predict needs --model")
    if options.data.byte_length() == 0:
        raise Error("predict needs --data")

    var table = read_table(options.data, options.header)
    # Scoring data usually has no label column, so one is dropped only when
    # --label says where it is.
    var label = -1
    if options.label_given:
        label = resolve_column(options.label, table.n_cols, String("label"))
    return predictions_text(options.model, table, label, options)


def command_info(args: List[String]) raises -> String:
    """Describe a saved model: a short summary, or the whole model as
    inspection-schema JSON with --json.

    The JSON is not formatted here. It comes from `dump_model` in
    inspection.mojo, the one implementation of that schema, which is what
    keeps `mojoboost info --json` and `Booster.dump_model()` in Python
    byte-identical for the same file.
    """
    var options = parse_options(args)
    if options.model.byte_length() == 0:
        raise Error("info needs --model")

    if model_file_kind(options.model) == "multiclass":
        var model = load_multiclass_model(options.model)
        if options.json:
            return dump_multiclass_model(model)
        return String(
            "kind: multiclass\nfeatures: ",
            model.mapper.n_features,
            "\nclasses: ",
            model.booster.n_classes,
            "\ntrees: ",
            len(model.booster.trees),
            "\niterations: ",
            model.booster.n_iterations(),
            "\nlearning_rate: ",
            model.booster.learning_rate,
        )
    var model = load_model(options.model)
    if options.json:
        return dump_model(model)
    return String(
        "kind: single-output\nobjective: ",
        objective_display_name(model.booster.objective),
        "\nfeatures: ",
        model.mapper.n_features,
        "\ntrees: ",
        len(model.booster.trees),
        "\niterations: ",
        model.booster.n_iterations(),
        "\nlearning_rate: ",
        model.booster.learning_rate,
    )


def run(args: List[String]) -> Int:
    """Run one command. Returns the process exit status and prints to
    stdout, or prints the reason to stderr and returns 1. Never raises, so
    `main` is a one-liner and tests can assert on the status."""
    if len(args) == 0:
        print(USAGE, file=stderr)
        return 2

    var command = args[0].copy()
    var rest = List[String]()
    for i in range(1, len(args)):
        rest.append(args[i].copy())

    if command == "help" or command == "--help" or command == "-h":
        print(USAGE)
        return 0
    if command == "version" or command == "--version":
        print(VERSION)
        return 0

    try:
        if command == "train":
            print(command_train(rest))
        elif command == "predict":
            var options = parse_options(rest)
            var text = command_predict(rest)
            if options.output.byte_length() == 0:
                print(text, end="")
            else:
                with open(options.output, "w") as f:
                    f.write(text)
                print(String("wrote ", options.output))
        elif command == "info":
            print(command_info(rest))
        else:
            print(String("unknown command '", command, "'"), file=stderr)
            print(USAGE, file=stderr)
            return 2
    except e:
        print(String("mojoboost: ", e), file=stderr)
        return 1
    return 0


def main():
    var args = List[String]()
    var raw = argv()
    for i in range(1, len(raw)):
        args.append(String(raw[i]))
    exit(run(args))
